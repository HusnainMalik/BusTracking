<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PermissionActivity"
    android:padding="32dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_location_on_black_24dp"
            android:layout_gravity="center_horizontal"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permission Request"
            android:layout_marginTop="12dp"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Place project need to access device location to provide required services Please Allow Persmission"
            android:layout_gravity="center_horizontal"
            android:fontFamily="sans-serif-condensed"
            android:textSize="24sp"
            android:layout_marginTop="36dp"/>

    </LinearLayout>
<Button
    android:id="@+id/btn_grant"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Grant Permission"
    android:textAllCaps="true"
    android:layout_alignParentBottom="true"
    android:background="@drawable/grad_bd"
    android:textColor="#FFFFFF"
    android:textSize="20sp"
    android:fontFamily="sans-serif-condensed"
    />


</RelativeLayout>